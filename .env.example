# Local development uses local-json. On a fresh Vercel deployment, leave
# CATALOG_BACKEND unset to serve the bundled read-only catalogue without secrets.
# Set vercel-blob only after connecting a private Blob store for Admin updates.
CATALOG_BACKEND=local-json
# Optional local catalog path. Render uses /var/data/catalog.json on its Persistent Disk.
CATALOG_LOCAL_PATH=.data/catalog.json
# Render: attach a Persistent Disk at /var/data, then set:
# CATALOG_LOCAL_PATH=/var/data/catalog.json
# UPLOADS_PATH=/var/data/uploads
# Token of the PRIVATE catalog JSON store. Never reuse the image-store token.
CATALOG_BLOB_READ_WRITE_TOKEN=

# This project is a catalogue. It has no cart, payment, order or customer database.
DEPLOYMENT_MODE=catalog
SITE_INDEXING_ENABLED=false
STORAGE_ADAPTER=local
# On Vercel, use STORAGE_ADAPTER=vercel-blob for Admin product-image uploads.

SESSION_SECRET=
RATE_LIMIT_SECRET=
HEALTHCHECK_SECRET=

ADMIN_EMAIL=
# Generate with: npm run admin:hash-password
# Store only the bcrypt hash; never add ADMIN_PASSWORD or plaintext passwords here.
ADMIN_PASSWORD_HASH=
ADMIN_DISPLAY_NAME=
ADMIN_SESSION_VERSION=1
# Token of the separate PUBLIC product-image store.
BLOB_READ_WRITE_TOKEN=
# Optional on Vercel: the production URL is derived from VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
INITIAL_STORE_AMAZON_URL=
